{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "inlar",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	"vars": {
		"CONTACT_FORM_SENDER": "web@inlar.com.ar",
		"CONTACT_FORM_RECIPIENT": "estudiojuridico@inlar.com.ar",
		"KEYSTATIC_GITHUB_CLIENT_ID": "Iv23liD3RZWHDyoaJ5Uw",
		"NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-1KEKPQMVS6",
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
}
